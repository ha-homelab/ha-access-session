{
  "repository": "ha-homelab/ha-access-session",
  "mode": "release",
  "default_branch": "main",
  "visibility": "public",
  "version_file": "version",
  "validation_workflows": [
    "tests.yml",
    "security.yml",
    "documentation.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "sh scripts/check.sh"
  ],
  "notes": [
    "Examples and screenshots are synthetic. Site configuration, credentials, real observations and private Git history are excluded.",
    "Offline tests cover simulated boundaries. A beta release does not establish compatibility with every camera, network or Home Assistant installation.",
    "The configured release-note file remains a full-validation input so its current release section, upgrade notes and security notes are checked.",
    "Documentation-consuming checks remain active on documentation-only PRs through the lightweight documentation validator."
  ],
  "release_notes": "CHANGELOG.md",
  "single_entry_ci": true,
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "version",
        "format": "text",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "pyproject.toml",
        "format": "toml",
        "field": "project.version",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "custom_components/ha_access_session/manifest.json",
        "format": "json",
        "field": "version",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "artifacts": [
      {
        "path": "ha-access-session-*.zip",
        "format": "zip-json",
        "member": "custom_components/ha_access_session/manifest.json",
        "field": "version",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "toolkit_revision": "f0bf0ec4921619f0de09ecd3eaa5e8673e4f9695"
  },
  "toolkit_revision": "f0bf0ec4921619f0de09ecd3eaa5e8673e4f9695",
  "sign_releases": true,
  "fuzzing": {
    "toolkit_ref": "4774181674f4a1a18488bfc918b4c5ed1df39163"
  },
  "change_scope": {
    "documentation_paths": [
      "GOVERNANCE.md",
      "ROADMAP.md"
    ],
    "required_paths": [
      "CHANGELOG.md"
    ],
    "always_validate_workflows": [
      "security.yml",
      "documentation.yml"
    ]
  }
}
